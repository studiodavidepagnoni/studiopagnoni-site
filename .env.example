# URL pubblico (canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://studiopagnoni.com

# Solo per deploy in sottocartella (es. GitHub Pages /nome-repo)
# NEXT_PUBLIC_BASE_PATH=/nome-repo

# Formspree — ID del form (https://formspree.io). Senza ID il form usa mailto.
# NON committare l'ID reale: solo in .env.local / GitHub Actions secrets.
# In dashboard Formspree (obbligatorio in produzione):
#   1) Restrict to domain: studiopagnoni.com (e www)
#   2) Abilita reCAPTCHA e incolla lo stesso secret di Google reCAPTCHA
NEXT_PUBLIC_FORMSPREE_ID=

# Google reCAPTCHA v2 (checkbox) — site key pubblica.
# Crea chiave su https://www.google.com/recaptcha/admin (dominio studiopagnoni.com).
# Il secret va SOLO in Formspree dashboard (non nel sito).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
